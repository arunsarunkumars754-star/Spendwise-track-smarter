# SpendWise - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Django Security
SECRET_KEY=django-insecure-spendwise-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Supported options: 'mysql' or 'sqlite3'
DB_ENGINE=mysql
DB_NAME=spendwise_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback to SQLite if MySQL is unavailable during local testing
DB_FALLBACK_SQLITE=True

# Application
DEFAULT_CURRENCY=INR
PAGE_SIZE=10
